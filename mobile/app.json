{
  "expo": {
    "name": "Advaspire",
    "slug": "advaspire",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "advaspire",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.advaspire.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.advaspire.academy",
      "adaptiveIcon": {
        "backgroundColor": "#615DFA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": "3.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Advaspire to access your photos so you can upload a payment slip or a student's work.",
          "cameraPermission": "Allow Advaspire to use the camera so you can take a photo of a student's work."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#615DFA",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "react-native-compressor"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "590a41fb-f906-48ed-a585-4cb9fe7b599d"
      }
    },
    "owner": "advaspire",
    "updates": {
      "url": "https://u.expo.dev/590a41fb-f906-48ed-a585-4cb9fe7b599d"
    },
    "runtimeVersion": "3.0.0"
  }
}
